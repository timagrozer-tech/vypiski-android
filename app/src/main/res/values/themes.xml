<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Заставка «291 Сканер» (core-splashscreen, единый вид на API 29–36). -->
    <style name="Theme.Scanner291.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Scanner291</item>
    </style>

    <!-- Основная тема окна; весь UI рисуется Compose (ScannerTheme). -->
    <style name="Theme.Scanner291" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
